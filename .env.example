# Copia este archivo a ".env" y coloca tus datos reales.
# Nunca subas el archivo ".env" a git (ya está en .gitignore).

# --- Base de datos (obligatoria, sin valor por defecto) ---
# Conexión a PostgreSQL. Estos son los mismos datos con los que te conectas
# en pgAdmin (click derecho en tu servidor > Properties > Connection).
# Ejemplo si en pgAdmin tu servidor está en localhost, puerto 5432,
# usuario postgres, y creaste una base llamada "sgd_sinole":
DATABASE_URL=postgresql+psycopg2://usuario:password@localhost:5432/sgd_sinole

# --- Seguridad (obligatoria, sin valor por defecto) ---
# Clave usada para firmar los tokens de sesión (login). Debe ser un texto
# largo y aleatorio, distinto en cada entorno (desarrollo/producción).
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Si la cookie de sesión debe llevar el atributo Secure (solo se envía por
# HTTPS). En producción debe quedar en "true" o simplemente no declararse
# (el default ya es true). Ponla en "false" SOLO en desarrollo local sin
# HTTPS (ej. http://127.0.0.1:8000), si no el navegador descarta la cookie.
SECURE_COOKIES=false

# --- Reglas de negocio (opcionales, tienen valor por defecto en config.py) ---
# A partir de cuántos días hábiles sin respuesta un documento pasa a "Vencido".
# DIAS_HABILES_LIMITE=5

# A partir de cuántos días hábiles sin respuesta un documento entra en "Por Vencer".
# DIAS_HABILES_ALERTA=4
